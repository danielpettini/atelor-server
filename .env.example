# Banco obrigatório; preencha somente no ambiente local ou no painel do Render
MONGODB_URI=

# Render injeta PORT automaticamente; use 4000 apenas no desenvolvimento local
PORT=4000

# No Render, configure 1 para confiar somente no primeiro proxy da plataforma
TRUST_PROXY_HOPS=1

# Origens HTTPS adicionais, separadas por vírgula; Electron e loopback já são aceitos
CORS_ALLOWED_ORIGINS=https://exemplo.com
